USE_PROCD=1
START=95
STOP=10

CONFIG=diplay

# Map UCI option -> command-line flag for oxp-cast.
append_cast_arg() {
	local opt="$1" flag="$2" value
	config_get value main "$opt"
	[ -n "$value" ] && append args "$flag $value"
}

start_service() {
	config_load "$CONFIG"

	local enabled
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	local cast_enabled
	config_get_bool cast_enabled main cast_enabled 1
	[ "$cast_enabled" -eq 1 ] || {
		echo "diplay-cast: no output enabled" >&2
		return 1
	}

	# Refuse to start without an MFi identity: CarPlay will never authenticate.
	local identity_pk8 identity_p7b
	config_get identity_pk8 main identity_pk8 /etc/diplay/identity/identity.pk8
	config_get identity_p7b main identity_p7b /etc/diplay/identity/certificate.p7b
	if [ ! -s "$identity_pk8" ] || [ ! -s "$identity_p7b" ]; then
		echo "diplay-cast: missing MFi identity ($identity_pk8 / $identity_p7b)" >&2
		echo "diplay-cast: place identity.pk8 and certificate.p7b in /etc/diplay/identity/ (mode 0600)" >&2
		return 1
	fi
	# Enforce private permissions if a user dropped them in with loose modes.
	chmod 0600 "$identity_pk8" "$identity_p7b" 2>/dev/null

	local relay_socket extra_args
	config_get relay_socket main relay_socket /run/openxplay-relay.sock
	config_get extra_args main extra_args ""

	# Build oxp-relay arguments: wire consumer + cast output.
	# The CarPlay receiver (direlay-linux) connects to the same unix socket as
	# the wire producer and feeds video/audio frames into oxp-relay.
	local args=""
	append args "--unix $relay_socket"
	append args "--no-tls"
	append args "--cast"

	append_cast_arg cast_udn --cast-udn
	append_cast_arg cast_width --cast-width
	append_cast_arg cast_height --cast-height
	append_cast_arg cast_fps --cast-fps
	append_cast_arg cast_port --cast-port
	append_cast_arg cast_title --cast-title
	append_cast_arg cast_interface --cast-interface

	local no_audio
	config_get_bool no_audio main cast_no_audio 0
	[ "$no_audio" -eq 1 ] && append args "--cast-no-audio"

	local wifi_country wifi_ssid wifi_key
	config_get wifi_country main wifi_country CN
	config_get wifi_ssid main wifi_ssid OpenXPlay-Car
	config_get wifi_key main wifi_key openxplay
	# The relay expects the AP to exist; hostapd is configured separately.
	# Export values for a hotplug/config script if needed.
	export OXP_WIFI_SSID="$wifi_ssid"
	export OXP_WIFI_KEY="$wifi_key"
	export OXP_WIFI_COUNTRY="$wifi_country"

	procd_open_instance diplay-cast
	procd_set_param command /usr/bin/oxp-relay $args $extra_args
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/diplay
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG"
}
